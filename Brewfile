# Brewfile — CLI tools only
# Safe to run on Mac AND Linux
# Install with: brew bundle --file=Brewfile

brew "git"      
brew "gh"      # GitHub CLI — auth, PRs, issues from terminal
brew "node"    # Node.js + npm
brew "ripgrep" # search tool for files, faster than grep
brew "python"  # Python programming language
brew "bat"     # syntax highlighting to visualize file contents from terminal
brew "jq"      # JSON parsing — required by the Claude Code status line script